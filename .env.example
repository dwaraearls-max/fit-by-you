# ---------------------------------------------------------------------------
# FIT BY YOU — environment
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# Database.
# Local development: use a free Neon/Supabase Postgres URL, or switch provider back
# to "sqlite" in prisma/schema.prisma and use file:./dev.db
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Signing secret for the session cookie. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="dev-only-secret-change-me-in-production-0000000000000000"

# Public origin, used for QR codes, receipts, absolute links and secure cookies.
# On Vercel this can be omitted — VERCEL_URL is used automatically during build.
# Set to your production domain once you have one, e.g. https://app.fitbyyou.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Force Secure session cookies. Defaults to true when NEXT_PUBLIC_APP_URL is https://.
# COOKIE_SECURE="false"

# File storage driver. "local" writes to STORAGE_ROOT on disk; an S3/R2 driver
# implements the same adapter interface in src/lib/storage.ts.
STORAGE_DRIVER="local"
STORAGE_ROOT=".storage"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_ENDPOINT=""
